<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ backup / device-transfer rules.
  Zones and history are backed up, and are also transferable directly between devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="." />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="." />
    </device-transfer>
</data-extraction-rules>
